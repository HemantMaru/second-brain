{
  "manifest_version": 3,
  "name": "NeuroVault Sync Pro",
  "version": "2.1",
  "permissions": ["activeTab", "scripting", "tabs"],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "http://localhost:3000/*",

    "https://*.youtube.com/*",
    "https://*.instagram.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.linkedin.com/*",
    "https://*.facebook.com/*",

    "https://*/*"
  ]
}
